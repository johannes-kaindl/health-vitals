{
  "name": "health-vitals",
  "version": "0.4.1",
  "description": "Import Apple Health exports and explore your health data in charts and tables.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs --production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:obsidian": "eslint . --max-warnings 0",
    "lint:portal": "eslint src --config eslint.portal.config.mjs --max-warnings 0",
    "deploy": "npm run build && cp main.js manifest.json styles.css \"${OBSIDIAN_PLUGIN_DIR:?set OBSIDIAN_PLUGIN_DIR}\"/",
    "version-bump": "node scripts/version-bump.mjs",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "healthkit",
    "health-data"
  ],
  "author": "Johannes Kaindl",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.23",
    "eslint": "^9",
    "eslint-plugin-obsidianmd": "0.4.1",
    "obsidian": "latest",
    "typescript": "^5.5",
    "typescript-eslint": "^8",
    "vitest": "^2"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
